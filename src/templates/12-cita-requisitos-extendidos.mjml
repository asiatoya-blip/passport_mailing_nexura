<mjml><mj-head><mj-font name="Plus Jakarta Sans" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" /></mj-head><mj-body background-color="#F5F6FA" width="640px"><mj-section background-color="#FFFFFF" padding="28px 32px 20px"><mj-column width="100%"><mj-table width="100%"><tr><td width="45%"><mj-image src="{{ENTITY_LOGO_URL}}" width="170px" align="left" padding="0"/></td><td width="55%" style="padding-left:16px;border-left:1px solid #E2E8F0"><p style="margin:0;font-size:13px;font-weight:600">{{ENTITY_SECRETARIAT_TITLE}}</p></td></tr></mj-table></mj-column></mj-section><mj-section background-color="#FFFFFF" padding="12px 32px 24px"><mj-column><mj-text align="center" font-size="20px" font-weight="700">Cita confirmada - Requisitos completos</mj-text></mj-column></mj-section><mj-section background-color="#FFFFFF" padding="24px 32px"><mj-column><mj-table width="100%"><tr align="center"><td width="25%"><div style="width:40px;height:40px;background-color:#DCFCE7;border-radius:50%;margin:0 auto 8px;line-height:40px;color:#15803D;font-weight:700">✓</div><p style="font-size:12px;font-weight:600;margin:0">Registro</p></td><td width="25%"><div style="width:40px;height:40px;background-color:#DCFCE7;border-radius:50%;margin:0 auto 8px;line-height:40px;color:#15803D;font-weight:700">✓</div><p style="font-size:12px;font-weight:600;margin:0">Primer pago</p></td><td width="25%"><div style="width:40px;height:40px;background-color:#DCFCE7;border-radius:50%;margin:0 auto 8px;line-height:40px;color:#15803D;font-weight:700">✓</div><p style="font-size:12px;font-weight:600;margin:0">Agendamiento</p></td><td width="25%"><div style="width:40px;height:40px;background-color:#E5E7EB;border-radius:50%;margin:0 auto 8px;line-height:40px;color:#9CA3AF;font-weight:700">4</div><p style="font-size:12px;font-weight:600;margin:0">Segundo pago</p></td></tr></mj-table></mj-column></mj-section><mj-section background-color="#FFFFFF" padding="0 32px 24px"><mj-column><mj-table padding="16px" container-background-color="#DCFCE7" style="border-radius:12px;width:100%"><tr><td width="36"><img src="https://assets.nexura.com/icons/check-badge-green.png" width="28" height="28" alt=""/></td><td style="padding-left:12px"><p style="margin:0;font-size:13px;color:#15803D"><strong>Cita confirmada</strong><br/>Aquí encuentras los requisitos desglosados por categoría.</p></td></tr></mj-table></mj-column></mj-section><mj-section background-color="#FFFFFF" padding="0 32px 24px"><mj-column><mj-table container-background-color="#F8F9FC" padding="24px" style="border-radius:16px;width:100%"><tr><td style="padding-bottom:16px"><p style="margin:0;font-size:14px;font-weight:600">Requisitos para Mayores de Edad</p></td></tr><tr><td style="padding-bottom:8px"><ul style="margin:0;padding-left:20px;font-size:13px;line-height:20px">{{#each REQUIREMENTS_ADULTS}}<li>{{this}}</li>{{/each}}</ul></td></tr></mj-table></mj-column></mj-section><mj-section background-color="#FFFFFF" padding="0 32px 24px"><mj-column><mj-table container-background-color="#F8F9FC" padding="24px" style="border-radius:16px;width:100%"><tr><td style="padding-bottom:16px"><p style="margin:0;font-size:14px;font-weight:600">Requisitos para Menores de Edad</p></td></tr><tr><td style="padding-bottom:8px"><ul style="margin:0;padding-left:20px;font-size:13px;line-height:20px">{{#each REQUIREMENTS_MINORS}}<li>{{this}}</li>{{/each}}</ul></td></tr></mj-table></mj-column></mj-section><mj-section background-color="#FFFFFF" padding="0 32px 24px"><mj-column><mj-button background-color="#1A6FE8" color="#FFFFFF" font-size="14px" font-weight="700" padding="14px 28px" border-radius="8px" href="{{RATE_URL}}" align="center">Califíquenos</mj-button></mj-column></mj-section><mj-section background-color="#FFFFFF" padding="28px 32px 32px" border-top="1px solid #F1F5F9"><mj-column><mj-text align="center" font-size="12px" color="#64748B">{{ENTITY_COPYRIGHT}}</mj-text></mj-column></mj-section></mj-body></mjml>
