<mjml>
  <mj-head>
    <mj-font name="Plus Jakarta Sans" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" />
    <mj-attributes><mj-all font-family="'Plus Jakarta Sans', Arial, Helvetica, sans-serif" color="#1F2937" /><mj-text font-size="14px" line-height="20px" padding="0" /><mj-section padding="0" /><mj-column padding="0" /></mj-attributes>
    <mj-raw><!--[if mso]><style type="text/css">body, table, td, p, a, span { font-family: Arial, Helvetica, sans-serif !important; }</style><![endif]--></mj-raw>
  </mj-head>
  <mj-body background-color="#F5F6FA" width="640px">
    <mj-section background-color="#FFFFFF" padding="28px 32px 20px 32px"><mj-group><mj-column width="45%" vertical-align="middle"><mj-image src="{{ENTITY_LOGO_URL}}" alt="{{ENTITY_NAME}}" width="170px" align="left" padding="0" /></mj-column><mj-column width="55%" vertical-align="middle"><mj-table padding="0 0 0 16px"><tr><td style="border-left: 1px solid #E2E8F0; padding-left: 16px;"><p style="margin: 0; font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 13px; font-weight: 600; color: #475569;">{{ENTITY_SECRETARIAT_TITLE}}</p></td></tr></mj-table></mj-column></mj-group></mj-section>

    <mj-section background-color="#FFFFFF" padding="12px 32px 24px 32px"><mj-column width="100%"><mj-text align="center" font-size="20px" font-weight="700" color="#0F172A">¡Cita agendada exitosamente!</mj-text></mj-column></mj-section>

    <mj-section background-color="#FFFFFF" padding="24px 32px"><mj-column width="100%"><mj-table width="100%" cellpadding="0" cellspacing="0"><tr align="center"><td width="25%"><div style="width: 40px; height: 40px; background-color: #DCFCE7; border-radius: 50%; margin: 0 auto 8px; line-height: 40px; color: #15803D; font-weight: 700;">✓</div><p style="font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 12px; font-weight: 600; color: #6B7280; margin: 0;">Registro</p></td><td width="25%"><div style="width: 40px; height: 40px; background-color: #DCFCE7; border-radius: 50%; margin: 0 auto 8px; line-height: 40px; color: #15803D; font-weight: 700;">✓</div><p style="font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 12px; font-weight: 600; color: #6B7280; margin: 0;">Primer pago</p></td><td width="25%"><div style="width: 40px; height: 40px; background-color: #DCFCE7; border-radius: 50%; margin: 0 auto 8px; line-height: 40px; color: #15803D; font-weight: 700;">✓</div><p style="font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 12px; font-weight: 600; color: #6B7280; margin: 0;">Agendamiento</p></td><td width="25%"><div style="width: 40px; height: 40px; background-color: #E5E7EB; border-radius: 50%; margin: 0 auto 8px; line-height: 40px; color: #9CA3AF; font-weight: 700;">4</div><p style="font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 12px; font-weight: 600; color: #6B7280; margin: 0;">Segundo pago</p></td></tr></mj-table></mj-column></mj-section>

    <mj-section background-color="#FFFFFF" padding="0 32px 24px 32px"><mj-column width="100%"><mj-table padding="16px" container-background-color="#DCFCE7" style="border-radius: 12px; width: 100%;"><tr><td width="36" style="vertical-align: middle; padding-right: 12px;"><img src="https://assets.nexura.com/icons/check-badge-green.png" width="28" height="28" style="display: block;" alt="" /></td><td style="vertical-align: middle;"><p style="margin: 0; font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 13px; color: #15803D;"><strong>Cita confirmada</strong><br />Tu cita ha sido agendada. Encuentra los detalles a continuación.</p></td></tr></mj-table></mj-column></mj-section>

    <mj-section background-color="#FFFFFF" padding="0 32px 24px 32px"><mj-column width="100%"><mj-table container-background-color="#F8F9FC" padding="24px" style="border-radius: 16px; width: 100%;"><tr><td colspan="2" style="padding-bottom: 16px;"><p style="margin: 0; font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 14px; font-weight: 600; color: #334155;">Datos de tu cita</p></td></tr><tr><td width="28" style="vertical-align: middle; padding: 8px 0;"><img src="https://assets.nexura.com/icons/id-card.png" width="20" height="20" style="display: block;" alt="" /></td><td style="vertical-align: middle; padding: 8px 12px 8px 4px;"><p style="margin: 0; font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 12px; color: #64748B;">Cédula</p><p style="margin: 0; font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 14px; font-weight: 600; color: #0F172A;">{{CITIZEN_ID}}</p></td></tr><tr><td colspan="2" style="height: 1px; background-color: #E5E7EB; padding: 0; margin: 8px 0;"></td></tr><tr><td width="28" style="vertical-align: middle; padding: 8px 0;"><img src="https://assets.nexura.com/icons/calendar.png" width="20" height="20" style="display: block;" alt="" /></td><td style="vertical-align: middle; padding: 8px 12px 8px 4px;"><p style="margin: 0; font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 12px; color: #64748B;">Fecha</p><p style="margin: 0; font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 14px; font-weight: 600; color: #0F172A;">{{APPOINTMENT_DATE}}</p></td></tr><tr><td colspan="2" style="height: 1px; background-color: #E5E7EB; padding: 0; margin: 8px 0;"></td></tr><tr><td width="28" style="vertical-align: middle; padding: 8px 0;"><img src="https://assets.nexura.com/icons/clock.png" width="20" height="20" style="display: block;" alt="" /></td><td style="vertical-align: middle; padding: 8px 12px 8px 4px;"><p style="margin: 0; font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 12px; color: #64748B;">Hora</p><p style="margin: 0; font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 14px; font-weight: 600; color: #0F172A;">{{APPOINTMENT_TIME}}</p></td></tr><tr><td colspan="2" style="height: 1px; background-color: #E5E7EB; padding: 0; margin: 8px 0;"></td></tr><tr><td width="28" style="vertical-align: middle; padding: 8px 0;"><img src="https://assets.nexura.com/icons/location.png" width="20" height="20" style="display: block;" alt="" /></td><td style="vertical-align: middle; padding: 8px 12px 8px 4px;"><p style="margin: 0; font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 12px; color: #64748B;">Ubicación</p><p style="margin: 0; font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 14px; font-weight: 600; color: #0F172A;">{{OFFICE_ADDRESS}}</p></td></tr><tr><td colspan="2" style="padding-top: 16px;"><a href="{{CALENDAR_ADD_URL}}" style="display: inline-block; background-color: #1A6FE8; color: #FFFFFF; font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 13px; font-weight: 600; text-decoration: none; padding: 10px 18px; border-radius: 8px;">Agregar al calendario</a></td></tr></mj-table></mj-column></mj-section>

    <mj-section background-color="#FFFFFF" padding="0 32px 24px 32px"><mj-column width="100%"><mj-table container-background-color="#FFFFFF" padding="20px 24px" style="border: 1px solid #E2E8F0; border-radius: 16px; width: 100%;"><tr><td colspan="2" style="padding-bottom: 8px;"><p style="margin: 0; font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 13px; font-weight: 700; color: #334155; text-transform: uppercase;">Instrucciones importantes</p></td></tr><tr><td colspan="2"><p style="margin: 0; font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 13px; line-height: 19px; color: #475569;">Recuerde presentarse <strong>10 minutos antes</strong> de la hora programada. Tenga a la mano su documento de identidad y los requisitos requeridos.</p></td></tr></mj-table></mj-column></mj-section>

    <mj-section background-color="#FFFFFF" padding="0 32px 24px 32px"><mj-column width="100%"><mj-table padding="20px" container-background-color="#FEF9E7" style="border-radius: 16px; width: 100%;"><tr><td width="36" style="vertical-align: top; padding-right: 12px;"><img src="https://assets.nexura.com/icons/warning-amber.png" width="28" height="28" style="display: block;" alt="" /></td><td><p style="margin: 0; font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 13px; font-weight: 700; color: #1E293B;">Recuerde el SITAC</p><p style="margin: 4px 0 0 0; font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 12px; color: #334155;">Si aún no completa el registro en Cancillería, puede hacerlo <a href="https://tramitesmre.cancilleria.gov.co/" style="color: #1A6FE8; text-decoration: underline;">aquí</a>.</p></td></tr></mj-table></mj-column></mj-section>

    <mj-section background-color="#FFFFFF" padding="16px 32px 28px 32px"><mj-column width="100%"><mj-text align="center" font-size="14px" font-weight="700" color="#0F172A" padding="0 0 16px 0">¿Cómo fue tu experiencia?</mj-text><mj-table width="320" cellpadding="0" cellspacing="0" align="center"><tr align="center"><td width="20%" style="padding: 0 6px;"><a href="{{CSAT_BASE_URL}}?score=1&type=schedule&id={{TRAMITE_ID}}" style="text-decoration: none;"><span style="font-size: 32px;">😢</span><p style="margin: 6px 0 0 0; font-size: 10px; color: #64748B;">Muy difícil</p></a></td><td width="20%" style="padding: 0 6px;"><a href="{{CSAT_BASE_URL}}?score=2&type=schedule&id={{TRAMITE_ID}}" style="text-decoration: none;"><span style="font-size: 32px;">😕</span><p style="margin: 6px 0 0 0; font-size: 10px; color: #64748B;">Difícil</p></a></td><td width="20%" style="padding: 0 6px;"><a href="{{CSAT_BASE_URL}}?score=3&type=schedule&id={{TRAMITE_ID}}" style="text-decoration: none;"><span style="font-size: 32px;">😐</span><p style="margin: 6px 0 0 0; font-size: 10px; color: #64748B;">Normal</p></a></td><td width="20%" style="padding: 0 6px;"><a href="{{CSAT_BASE_URL}}?score=4&type=schedule&id={{TRAMITE_ID}}" style="text-decoration: none;"><span style="font-size: 32px;">🙂</span><p style="margin: 6px 0 0 0; font-size: 10px; color: #64748B;">Fácil</p></a></td><td width="20%" style="padding: 0 6px;"><a href="{{CSAT_BASE_URL}}?score=5&type=schedule&id={{TRAMITE_ID}}" style="text-decoration: none;"><span style="font-size: 32px;">😄</span><p style="margin: 6px 0 0 0; font-size: 10px; color: #64748B;">Muy fácil</p></a></td></tr></mj-table></mj-column></mj-section>

    <mj-section background-color="#FFFFFF" padding="28px 32px 32px 32px" border-top="1px solid #F1F5F9"><mj-column width="100%"><mj-text align="center" font-size="14px" font-weight="600" color="#334155">Gracias por utilizar nuestros servicios</mj-text><mj-text align="center" font-size="12px" color="#64748B">{{ENTITY_COPYRIGHT}}</mj-text></mj-column></mj-section>
  </mj-body>
</mjml>
