<mjml><mj-head><mj-font name="Plus Jakarta Sans" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" /><mj-raw><!--[if mso]><style>body,table,td,p{font-family:Arial,sans-serif!important}</style><![endif]--></mj-raw></mj-head><mj-body background-color="#F5F6FA" width="640px"><mj-section background-color="#FFFFFF" padding="28px 32px 20px"><mj-group><mj-column width="45%"><mj-image src="{{ENTITY_LOGO_URL}}" width="170px" align="left" padding="0" /></mj-column><mj-column width="55%"><mj-table padding="0 0 0 16px"><tr><td style="border-left:1px solid #E2E8F0;padding-left:16px"><p style="margin:0;font-size:13px;font-weight:600">{{ENTITY_SECRETARIAT_TITLE}}</p></td></tr></mj-table></mj-column></mj-group></mj-section><mj-section background-color="#FFFFFF" padding="12px 32px 24px"><mj-column><mj-text align="center" font-size="20px" font-weight="700">Solicitud de segundo pago</mj-text></mj-column></mj-section><mj-section background-color="#FFFFFF" padding="24px 32px"><mj-column><mj-table width="100%"><tr align="center"><td width="25%"><div style="width:40px;height:40px;background-color:#DCFCE7;border-radius:50%;margin:0 auto 8px;line-height:40px;color:#15803D;font-weight:700">✓</div><p style="font-size:12px;font-weight:600;margin:0">Registro</p></td><td width="25%"><div style="width:40px;height:40px;background-color:#DCFCE7;border-radius:50%;margin:0 auto 8px;line-height:40px;color:#15803D;font-weight:700">✓</div><p style="font-size:12px;font-weight:600;margin:0">Primer pago</p></td><td width="25%"><div style="width:40px;height:40px;background-color:#DCFCE7;border-radius:50%;margin:0 auto 8px;line-height:40px;color:#15803D;font-weight:700">✓</div><p style="font-size:12px;font-weight:600;margin:0">Agendamiento</p></td><td width="25%"><div style="width:40px;height:40px;background-color:#DBEAFE;border-radius:50%;margin:0 auto 8px;line-height:40px;color:#1D4ED8;font-weight:700">⏱</div><p style="font-size:12px;font-weight:600;margin:0">Segundo pago</p></td></tr></mj-table></mj-column></mj-section><mj-section background-color="#FFFFFF" padding="0 32px 24px"><mj-column><mj-table padding="16px" container-background-color="#DBEAFE" style="border-radius:12px;width:100%"><tr><td width="36"><img src="https://assets.nexura.com/icons/info-blue.png" width="28" height="28" alt="" /></td><td style="padding-left:12px"><p style="margin:0;font-size:13px;color:#1D4ED8"><strong>Llegó el momento del segundo pago</strong><br />Tu cita ha sido aprobada. Ahora debes completar el segundo pago en Cancillería.</p></td></tr></mj-table></mj-column></mj-section><mj-section background-color="#FFFFFF" padding="0 32px 24px"><mj-column><mj-table container-background-color="#F8F9FC" padding="20px 24px" style="border-radius:16px;width:100%"><tr><td colspan="2" style="padding-bottom:12px"><p style="margin:0;font-size:14px;font-weight:600">Tarifas de segundo pago</p></td></tr><tr><td width="32%" style="padding:12px 6px;border-right:1px solid #F1F5F9;text-align:center"><p style="margin:0;font-size:14px;font-weight:700">${{PRICE_P2_ORD}}</p><p style="margin:4px 0 0 0;font-size:11px;color:#64748B">Ordinario</p></td><td width="32%" style="padding:12px 6px;border-right:1px solid #F1F5F9;text-align:center"><p style="margin:0;font-size:14px;font-weight:700">${{PRICE_P2_EXE}}</p><p style="margin:4px 0 0 0;font-size:11px;color:#64748B">Ejecutivo</p></td><td width="32%" style="padding:12px 6px;text-align:center"><p style="margin:0;font-size:14px;font-weight:700">${{PRICE_P2_EME}}</p><p style="margin:4px 0 0 0;font-size:11px;color:#64748B">Emergencia</p></td></tr><tr><td colspan="3" style="padding-top:12px;border-top:1px solid #E5E7EB"><p style="margin:0;font-size:11px;color:#64748B;text-align:center">Presentando certificado electoral obtiene 10% de descuento</p></td></tr></mj-table></mj-column></mj-section><mj-section background-color="#FFFFFF" padding="0 32px 24px"><mj-column><mj-button background-color="#1A6FE8" color="#FFFFFF" font-size="14px" font-weight="700" padding="14px 28px" border-radius="8px" href="{{PAYMENT_URL}}" align="center">Continuar al segundo pago</mj-button></mj-column></mj-section><mj-section background-color="#FFFFFF" padding="28px 32px 32px" border-top="1px solid #F1F5F9"><mj-column><mj-text align="center" font-size="12px" color="#64748B">{{ENTITY_COPYRIGHT}}</mj-text></mj-column></mj-section></mj-body></mjml>
