<mjml>
  <mj-head>
    <mj-include path="../components/head-styles.mjml" />
    <mj-title>Solicitud Segundo Pago</mj-title>
  </mj-head>
  <mj-body background-color="#F9FAFB" padding="0">
    <mj-section background-color="#F9FAFB" padding="20px 0">
      <mj-column width="640">
        <mj-spacer height="12px" />
        <mj-include path="../components/header.mjml" />
        <mj-section background-color="#FFFFFF" padding="32px 20px" style="border-radius: 16px; margin: 12px 20px 0 20px; border: 1px solid #E5E5EA;">
          <mj-column>
            <mj-text align="center" font-size="24px" color="#1F2937" font-weight="600" font-family="'Plus Jakarta Sans', Arial, sans-serif" margin="0">
              {{PAGE_TITLE}}
            </mj-text>
          </mj-column>
        </mj-section>
        <mj-section background-color="transparent" padding="20px 20px 0 20px">
          <mj-column>
            <mj-include path="../components/stepper.mjml" />
          </mj-column>
        </mj-section>
        <mj-section background-color="transparent" padding="20px 20px 0 20px">
          <mj-column>
            <mj-section background-color="#DBEAFE" padding="16px 20px" style="border-radius: 16px; margin: 0;">
              <mj-column>
                <mj-table width="100%">
                  <tr>
                    <td width="32" style="padding: 0 12px 0 0; font-size: 24px; vertical-align: top;">{{ALERT_ICON}}</td>
                    <td style="padding: 0;">
                      <p style="font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 13px; color: #0C4A6E; margin: 0; font-weight: 700;">{{ALERT_TITLE}}</p>
                      <p style="font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 12px; color: #0C4A6E; margin: 4px 0 0 0;">{{ALERT_TEXT}}</p>
                    </td>
                  </tr>
                </mj-table>
              </mj-column>
            </mj-section>
          </mj-column>
        </mj-section>
        <mj-section background-color="#FFFFFF" padding="20px" style="border-radius: 16px; margin: 20px 20px 0 20px; border: 1px solid #E5E5EA;">
          <mj-column>
            <p style="font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 14px; font-weight: 700; color: #1F2937; margin: 0 0 16px 0;">{{DATA_LIST_TITLE}}</p>
            <table width="100%" style="border-collapse: collapse;">
              <tr style="border-bottom: 1px solid #E5E5EA;">
                <td width="140" style="padding: 12px 0; font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 12px; font-weight: 600; color: #6B7280;">{{DATA_LABEL_1}}</td>
                <td style="padding: 12px 0 12px 16px; font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 14px; color: #1F2937;">{{DATA_VALUE_1}}</td>
              </tr>
              <tr style="border-bottom: 1px solid #E5E5EA;">
                <td style="padding: 12px 0; font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 12px; font-weight: 600; color: #6B7280;">{{DATA_LABEL_2}}</td>
                <td style="padding: 12px 0 12px 16px; font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 14px; color: #1F2937;">{{DATA_VALUE_2}}</td>
              </tr>
              <tr style="border-bottom: 1px solid #E5E5EA;">
                <td style="padding: 12px 0; font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 12px; font-weight: 600; color: #6B7280;">{{DATA_LABEL_3}}</td>
                <td style="padding: 12px 0 12px 16px; font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 14px; color: #1F2937;">{{DATA_VALUE_3}}</td>
              </tr>
              <tr style="border-bottom: 1px solid #E5E5EA;">
                <td style="padding: 12px 0; font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 12px; font-weight: 600; color: #6B7280;">{{DATA_LABEL_4}}</td>
                <td style="padding: 12px 0 12px 16px; font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 14px; color: #1F2937;">{{DATA_VALUE_4}}</td>
              </tr>
              <tr style="border-bottom: 1px solid #E5E5EA;">
                <td style="padding: 12px 0; font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 12px; font-weight: 600; color: #6B7280;">{{DATA_LABEL_5}}</td>
                <td style="padding: 12px 0 12px 16px; font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 14px; color: #1F2937;">{{DATA_VALUE_5}}</td>
              </tr>
              <tr>
                <td style="padding: 12px 0; font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 12px; font-weight: 600; color: #6B7280;">{{DATA_LABEL_6}}</td>
                <td style="padding: 12px 0 12px 16px; font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 14px; color: #1F2937;">{{DATA_VALUE_6}}</td>
              </tr>
            </table>
          </mj-column>
        </mj-section>
        <mj-section background-color="#FFFFFF" padding="20px" style="border-radius: 16px; margin: 20px 20px 0 20px; border: 1px solid #E5E5EA;">
          <mj-column>
            <p style="font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 14px; color: #1F2937; margin: 0 0 16px 0;">{{PRICING_INSTRUCTION}}</p>
            <table width="100%" style="border-collapse: collapse;">
              <tr>
                <td width="31%" style="padding: 16px; text-align: center; border: 1px solid #E5E5EA; border-radius: 8px;">
                  <p style="font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 12px; font-weight: 600; color: #6B7280; margin: 0 0 8px 0;">{{OPTION1_LABEL}}</p>
                  <p style="font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 16px; font-weight: 700; color: #1F2937; margin: 0;">{{OPTION1_PRICE}}</p>
                  <p style="font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 11px; color: #6B7280; margin: 4px 0 0 0;">{{OPTION1_DAYS}}</p>
                </td>
                <td width="4%"></td>
                <td width="31%" style="padding: 16px; text-align: center; border: 2px solid #0F61E4; border-radius: 8px; background-color: #EFF6FF;">
                  <p style="font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 10px; font-weight: 700; color: white; margin: 0 0 8px 0; background: #0F61E4; padding: 4px 8px; border-radius: 4px; display: inline-block;">RECOMENDADO</p>
                  <p style="font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 12px; font-weight: 600; color: #1F2937; margin: 8px 0 8px 0;">{{OPTION2_LABEL}}</p>
                  <p style="font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 16px; font-weight: 700; color: #0F61E4; margin: 0;">{{OPTION2_PRICE}}</p>
                  <p style="font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 11px; color: #6B7280; margin: 4px 0 0 0;">{{OPTION2_DAYS}}</p>
                </td>
                <td width="4%"></td>
                <td width="31%" style="padding: 16px; text-align: center; border: 1px solid #E5E5EA; border-radius: 8px;">
                  <p style="font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 12px; font-weight: 600; color: #6B7280; margin: 0 0 8px 0;">{{OPTION3_LABEL}}</p>
                  <p style="font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 16px; font-weight: 700; color: #1F2937; margin: 0;">{{OPTION3_PRICE}}</p>
                  <p style="font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 11px; color: #6B7280; margin: 4px 0 0 0;">{{OPTION3_DAYS}}</p>
                </td>
              </tr>
            </table>
          </mj-column>
        </mj-section>
        <mj-section background-color="transparent" padding="20px 20px 0 20px">
          <mj-column>
            <table width="100%" style="border-collapse: collapse;">
              <tr>
                <td align="center" style="padding: 0;">
                  <a href="{{BUTTON_PRIMARY_URL}}" style="display: inline-block; padding: 12px 24px; background-color: #0F61E4; border-radius: 999px; color: #FFFFFF; text-decoration: none; font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 16px; font-weight: 400; line-height: 28.80px; text-align: center;">{{BUTTON_PRIMARY_TEXT}}</a>
                </td>
              </tr>
            </table>
          </mj-column>
        </mj-section>
        <mj-section background-color="transparent" padding="20px 20px 0 20px">
          <mj-column>
            <mj-section background-color="#FEF3C7" padding="16px 20px" style="border-radius: 16px; margin: 0;">
              <mj-column>
                <table width="100%">
                  <tr>
                    <td width="32" style="padding: 0 12px 0 0; font-size: 24px; vertical-align: top;">⚠️</td>
                    <td style="padding: 0;">
                      <p style="font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 13px; color: #92400E; margin: 0; font-weight: 700;">{{NOTICE1_TITLE}}</p>
                      <p style="font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 12px; color: #92400E; margin: 4px 0 0 0;">{{NOTICE1_TEXT}}</p>
                      <p style="font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 12px; color: #0F61E4; margin: 4px 0 0 0; text-decoration: underline;"><a href="{{NOTICE1_LINK}}" style="color: #0F61E4; text-decoration: underline;">{{NOTICE1_LINK_TEXT}}</a></p>
                    </td>
                  </tr>
                </table>
              </mj-column>
            </mj-section>
          </mj-column>
        </mj-section>
        <mj-section background-color="transparent" padding="12px 20px 0 20px">
          <mj-column>
            <mj-section background-color="#FEF3C7" padding="16px 20px" style="border-radius: 16px; margin: 0;">
              <mj-column>
                <table width="100%">
                  <tr>
                    <td width="32" style="padding: 0 12px 0 0; font-size: 24px; vertical-align: top;">ℹ️</td>
                    <td style="padding: 0;">
                      <p style="font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 13px; color: #92400E; margin: 0; font-weight: 700;">{{NOTICE2_TITLE}}</p>
                      <p style="font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 12px; color: #92400E; margin: 4px 0 0 0;">{{NOTICE2_TEXT}}</p>
                    </td>
                  </tr>
                </table>
              </mj-column>
            </mj-section>
          </mj-column>
        </mj-section>
        <mj-section background-color="transparent" padding="20px 0">
          <mj-column>
            <mj-include path="../components/footer.mjml" />
          </mj-column>
        </mj-section>
        <mj-spacer height="12px" />
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>