<mjml><mj-head><mj-font name="Plus Jakarta Sans" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" /></mj-head><mj-body background-color="#F5F6FA" width="640px"><mj-section background-color="#FFFFFF" padding="28px 32px 20px"><mj-column width="100%"><mj-table width="100%"><tr><td width="45%"><mj-image src="{{ENTITY_LOGO_URL}}" width="170px" align="left" padding="0"/></td><td width="55%" style="padding:0 0 0 16px;border-left:1px solid #E2E8F0"><p style="margin:0;font-size:13px;font-weight:600;padding-left:16px">{{ENTITY_SECRETARIAT_TITLE}}</p></td></tr></mj-table></mj-column></mj-section><mj-section background-color="#FFFFFF" padding="12px 32px 24px"><mj-column><mj-text align="center" font-size="20px" font-weight="700">Recordatorio de tu cita</mj-text></mj-column></mj-section><mj-section background-color="#FFFFFF" padding="0 32px 24px"><mj-column><mj-table padding="16px" container-background-color="#DBEAFE" style="border-radius:12px;width:100%"><tr><td width="36"><img src="https://assets.nexura.com/icons/bell.png" width="28" height="28" alt=""/></td><td style="padding-left:12px"><p style="margin:0;font-size:13px;color:#1D4ED8"><strong>Tu cita está próxima</strong><br/>Recuerda asistir el día y hora programados. Ten a la mano tu cédula y los requisitos.</p></td></tr></mj-table></mj-column></mj-section><mj-section background-color="#FFFFFF" padding="0 32px 24px"><mj-column><mj-table container-background-color="#F8F9FC" padding="24px" style="border-radius:16px;width:100%"><tr><td colspan="2" style="padding-bottom:16px"><p style="margin:0;font-size:14px;font-weight:600">Datos de tu cita</p></td></tr><tr><td width="28"><img src="https://assets.nexura.com/icons/calendar.png" width="20" height="20" alt=""/></td><td style="padding:8px 0 8px 12px"><p style="margin:0;font-size:12px;color:#64748B">Fecha</p><p style="margin:0;font-size:14px;font-weight:600">{{APPOINTMENT_DATE}}</p></td></tr><tr><td colspan="2" style="height:1px;background-color:#E5E7EB;padding:0;margin:8px 0"></td></tr><tr><td width="28"><img src="https://assets.nexura.com/icons/clock.png" width="20" height="20" alt=""/></td><td style="padding:8px 0 8px 12px"><p style="margin:0;font-size:12px;color:#64748B">Hora</p><p style="margin:0;font-size:14px;font-weight:600">{{APPOINTMENT_TIME}}</p></td></tr><tr><td colspan="2" style="height:1px;background-color:#E5E7EB;padding:0;margin:8px 0"></td></tr><tr><td width="28"><img src="https://assets.nexura.com/icons/location.png" width="20" height="20" alt=""/></td><td style="padding:8px 0 8px 12px"><p style="margin:0;font-size:12px;color:#64748B">Ubicación</p><p style="margin:0;font-size:14px;font-weight:600">{{OFFICE_ADDRESS}}</p></td></tr></mj-table></mj-column></mj-section><mj-section background-color="#FFFFFF" padding="0 32px 24px"><mj-column><mj-button background-color="#1A6FE8" color="#FFFFFF" font-size="14px" font-weight="700" padding="14px 28px" border-radius="8px" href="{{RESCHEDULE_URL}}" align="center">¿Necesita reprogramar?</mj-button></mj-column></mj-section><mj-section background-color="#FFFFFF" padding="28px 32px 32px" border-top="1px solid #F1F5F9"><mj-column><mj-text align="center" font-size="12px" color="#64748B">{{ENTITY_COPYRIGHT}}</mj-text></mj-column></mj-section></mj-body></mjml>
