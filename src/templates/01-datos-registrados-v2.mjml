<mjml>
  <mj-head>
    <mj-include path="../components/head-styles.mjml" />
    <mj-title>Datos Registrados - Gobernación del Huila</mj-title>
  </mj-head>

  <mj-body background-color="#F9FAFB" padding="0">
    <!-- CONTENEDOR PRINCIPAL -->
    <mj-section background-color="#F9FAFB" padding="20px 0">
      <mj-column width="640">
        <mj-spacer height="12px" />

        <!-- HEADER -->
        <mj-include path="../components/header.mjml" />

        <!-- TITLE HERO -->
        <mj-section background-color="#FFFFFF" padding="32px 20px" style="border-radius: 16px; margin: 12px 20px 0 20px; border: 1px solid #E5E5EA;">
          <mj-column>
            <mj-text align="center" font-size="28px" color="#1F2937" font-weight="700" font-family="'Plus Jakarta Sans', Arial, sans-serif" margin="0">
              ¡Datos registrados exitosamente!
            </mj-text>
          </mj-column>
        </mj-section>

        <!-- STEPPER -->
        <mj-section background-color="transparent" padding="20px 20px 0 20px">
          <mj-column>
            <mj-include path="../components/stepper.mjml" />
          </mj-column>
        </mj-section>

        <!-- ALERT BANNER - GREEN -->
        <mj-section background-color="transparent" padding="20px 20px 0 20px">
          <mj-column>
            <mj-include path="../components/alert-banner.mjml" />
          </mj-column>
        </mj-section>

        <!-- DATA LIST CARD - DATOS REGISTRADOS -->
        <mj-section background-color="#FFFFFF" padding="20px" style="border-radius: 16px; margin: 12px 20px 0 20px; border: 1px solid #E5E5EA;">
          <mj-column>
            <mj-text font-size="14px" font-weight="700" color="#1F2937" font-family="'Plus Jakarta Sans', Arial, sans-serif" margin="0 0 16px 0">
              Datos registrados
            </mj-text>

            <mj-table width="100%" style="border-collapse: collapse;">
              <tr style="border-bottom: 1px solid #E5E5EA;">
                <td width="140" style="padding: 12px 0 12px 0; font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 12px; font-weight: 600; color: #6B7280;">Nombre completo</td>
                <td style="padding: 12px 0 12px 16px; font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 12px; color: #1F2937;">{{CITIZEN_FULLNAME}}</td>
              </tr>
              <tr style="border-bottom: 1px solid #E5E5EA;">
                <td width="140" style="padding: 12px 0 12px 0; font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 12px; font-weight: 600; color: #6B7280;">Número de cédula</td>
                <td style="padding: 12px 0 12px 16px; font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 12px; color: #1F2937;">{{CITIZEN_ID}}</td>
              </tr>
              <tr>
                <td width="140" style="padding: 12px 0 0 0; font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 12px; font-weight: 600; color: #6B7280;">Fecha de nacimiento</td>
                <td style="padding: 12px 0 0 16px; font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 12px; color: #1F2937;">{{CITIZEN_DOB}}</td>
              </tr>
            </mj-table>
          </mj-column>
        </mj-section>

        <!-- PRICING SELECTOR -->
        <mj-section background-color="#FFFFFF" padding="20px" style="border-radius: 16px; margin: 12px 20px 0 20px; border: 1px solid #E5E5EA;">
          <mj-column>
            <mj-text font-size="14px" font-weight="700" color="#1F2937" font-family="'Plus Jakarta Sans', Arial, sans-serif" margin="0 0 16px 0">
              Selecciona el tipo de pasaporte
            </mj-text>

            <mj-table width="100%" style="border-collapse: collapse;">
              <tr>
                <td width="33%" align="center" style="padding: 16px 8px; border-right: 1px solid #E5E5EA;">
                  <div style="font-size: 24px; margin-bottom: 8px;">🌍</div>
                  <p style="font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 11px; font-weight: 600; color: #6B7280; margin: 0 0 4px 0;">{{TARIFF_ORDINARIO_LABEL}}</p>
                  <p style="font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 11px; color: #6B7280; margin: 0 0 4px 0;">{{TARIFF_ORDINARIO_DAYS}}</p>
                  <p style="font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 16px; font-weight: 700; color: #1A6FE8; margin: 0;">{{TARIFF_ORDINARIO_PRICE}}</p>
                </td>
                <td width="33%" align="center" style="padding: 16px 8px; border-right: 1px solid #E5E5EA; background-color: #F0F9FF; border-radius: 8px; margin: 0 4px;">
                  <div style="font-size: 24px; margin-bottom: 8px;">✈️</div>
                  <p style="font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 10px; font-weight: 700; color: #1A6FE8; background-color: #1A6FE8; color: #FFFFFF; padding: 2px 6px; border-radius: 12px; margin: 0 0 4px 0; display: inline-block;">RECOMENDADO</p>
                  <p style="font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 11px; font-weight: 600; color: #6B7280; margin: 4px 0 4px 0;">{{TARIFF_EJECUTIVO_LABEL}}</p>
                  <p style="font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 11px; color: #6B7280; margin: 0 0 4px 0;">{{TARIFF_EJECUTIVO_DAYS}}</p>
                  <p style="font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 16px; font-weight: 700; color: #1A6FE8; margin: 0;">{{TARIFF_EJECUTIVO_PRICE}}</p>
                </td>
                <td width="33%" align="center" style="padding: 16px 8px;">
                  <div style="font-size: 24px; margin-bottom: 8px;">🚀</div>
                  <p style="font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 11px; font-weight: 600; color: #6B7280; margin: 0 0 4px 0;">{{TARIFF_EMERGENCIA_LABEL}}</p>
                  <p style="font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 11px; color: #6B7280; margin: 0 0 4px 0;">{{TARIFF_EMERGENCIA_DAYS}}</p>
                  <p style="font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 16px; font-weight: 700; color: #1A6FE8; margin: 0;">{{TARIFF_EMERGENCIA_PRICE}}</p>
                </td>
              </tr>
            </mj-table>
          </mj-column>
        </mj-section>

        <!-- BOTÓN PRIMARY -->
        <mj-section background-color="transparent" padding="20px 20px 0 20px">
          <mj-column>
            <mj-button background-color="#1A6FE8" color="#FFFFFF" font-size="14px" font-weight="700" font-family="'Plus Jakarta Sans', Arial, sans-serif" padding="14px 32px" border-radius="100px" href="{{BUTTON_CONTINUE_PAYMENT_URL}}" align="center" width="auto">
              {{BUTTON_CONTINUE_PAYMENT_TEXT}}
            </mj-button>
          </mj-column>
        </mj-section>

        <!-- NOTICE - REQUISITOS -->
        <mj-section background-color="#FEF3C7" padding="16px" style="border-radius: 16px; margin: 20px 20px 0 20px; border-left: 4px solid #FCD34D;">
          <mj-column>
            <mj-table width="100%" style="border-collapse: collapse;">
              <tr>
                <td width="32" style="padding: 0 12px 0 0; font-size: 24px;">⚠️</td>
                <td style="padding: 0;">
                  <p style="font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 12px; font-weight: 600; color: #92400E; margin: 0 0 8px 0;">{{NOTICE_REQUIREMENTS_TITLE}}</p>
                  <p style="font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 12px; color: #78350F; margin: 0 0 8px 0;">{{NOTICE_REQUIREMENTS_MESSAGE}}</p>
                  <a href="{{NOTICE_REQUIREMENTS_LINK}}" style="font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 12px; color: #1A6FE8; text-decoration: none; font-weight: 600;">{{NOTICE_REQUIREMENTS_LINK_TEXT}}</a>
                </td>
              </tr>
            </mj-table>
          </mj-column>
        </mj-section>

        <!-- NOTICE - SITAC -->
        <mj-section background-color="#FEF3C7" padding="16px" style="border-radius: 16px; margin: 12px 20px 0 20px; border-left: 4px solid #FCD34D;">
          <mj-column>
            <mj-table width="100%" style="border-collapse: collapse;">
              <tr>
                <td width="32" style="padding: 0 12px 0 0; font-size: 24px;">ℹ️</td>
                <td style="padding: 0;">
                  <p style="font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 12px; font-weight: 600; color: #92400E; margin: 0 0 4px 0;">{{NOTICE_SITAC_TITLE}}</p>
                  <p style="font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 12px; color: #78350F; margin: 0;">{{NOTICE_SITAC_MESSAGE}}</p>
                </td>
              </tr>
            </mj-table>
          </mj-column>
        </mj-section>

        <!-- FOOTER -->
        <mj-section background-color="transparent" padding="20px 0">
          <mj-column>
            <mj-include path="../components/footer.mjml" />
          </mj-column>
        </mj-section>

        <mj-spacer height="12px" />
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
