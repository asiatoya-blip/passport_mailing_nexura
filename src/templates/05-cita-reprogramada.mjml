<mjml>
  <mj-head><mj-font name="Plus Jakarta Sans" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" /><mj-attributes><mj-all font-family="'Plus Jakarta Sans', Arial, sans-serif" /><mj-text font-size="14px" padding="0" /><mj-section padding="0" /><mj-column padding="0" /></mj-attributes><mj-raw><!--[if mso]><style>body, table, td, p { font-family: Arial, sans-serif !important; }</style><![endif]--></mj-raw></mj-head>
  <mj-body background-color="#F5F6FA" width="640px">
    <mj-section background-color="#FFFFFF" padding="28px 32px 20px"><mj-group><mj-column width="45%"><mj-image src="{{ENTITY_LOGO_URL}}" width="170px" align="left" padding="0" /></mj-column><mj-column width="55%"><mj-table padding="0 0 0 16px"><tr><td style="border-left: 1px solid #E2E8F0; padding-left: 16px;"><p style="margin: 0; font-size: 13px; font-weight: 600; color: #475569;">{{ENTITY_SECRETARIAT_TITLE}}</p></td></tr></mj-table></mj-column></mj-group></mj-section>
    <mj-section background-color="#FFFFFF" padding="12px 32px 24px"><mj-column><mj-text align="center" font-size="20px" font-weight="700" color="#0F172A">¡Cita reprogramada!</mj-text></mj-column></mj-section>
    <mj-section background-color="#FFFFFF" padding="24px 32px"><mj-column><mj-table width="100%"><tr align="center"><td width="25%"><div style="width: 40px; height: 40px; background-color: #DCFCE7; border-radius: 50%; margin: 0 auto 8px; line-height: 40px; color: #15803D; font-weight: 700;">✓</div><p style="font-size: 12px; font-weight: 600; color: #6B7280; margin: 0;">Registro</p></td><td width="25%"><div style="width: 40px; height: 40px; background-color: #DCFCE7; border-radius: 50%; margin: 0 auto 8px; line-height: 40px; color: #15803D; font-weight: 700;">✓</div><p style="font-size: 12px; font-weight: 600; color: #6B7280; margin: 0;">Primer pago</p></td><td width="25%"><div style="width: 40px; height: 40px; background-color: #F3E8FF; border-radius: 50%; margin: 0 auto 8px; line-height: 40px; color: #7E22CE; font-weight: 700; font-size: 20px;">🔄</div><p style="font-size: 12px; font-weight: 600; color: #6B7280; margin: 0;">Agendamiento</p></td><td width="25%"><div style="width: 40px; height: 40px; background-color: #E5E7EB; border-radius: 50%; margin: 0 auto 8px; line-height: 40px; color: #9CA3AF; font-weight: 700;">4</div><p style="font-size: 12px; font-weight: 600; color: #6B7280; margin: 0;">Segundo pago</p></td></tr></mj-table></mj-column></mj-section>
    <mj-section background-color="#FFFFFF" padding="0 32px 24px"><mj-column><mj-table padding="16px" container-background-color="#F3E8FF" style="border-radius: 12px; width: 100%;"><tr><td width="36"><img src="https://assets.nexura.com/icons/refresh-purple.png" width="28" height="28" style="display: block;" alt="" /></td><td style="padding-left: 12px;"><p style="margin: 0; font-size: 13px; color: #7E22CE;"><strong>Cita reprogramada</strong><br />Tu cita ha sido cambiada a una nueva fecha. Verifica los detalles.</p></td></tr></mj-table></mj-column></mj-section>
    <mj-section background-color="#FFFFFF" padding="0 32px 24px"><mj-column><mj-table container-background-color="#F8F9FC" padding="24px" style="border-radius: 16px; width: 100%;"><tr><td colspan="2" style="padding-bottom: 16px;"><p style="margin: 0; font-size: 14px; font-weight: 600; color: #334155;">Nueva fecha de cita</p></td></tr><tr><td width="28"><img src="https://assets.nexura.com/icons/calendar.png" width="20" height="20" style="display: block;" alt="" /></td><td style="padding: 8px 0 8px 12px;"><p style="margin: 0; font-size: 12px; color: #64748B;">Fecha</p><p style="margin: 0; font-size: 14px; font-weight: 600; color: #0F172A;">{{APPOINTMENT_DATE}}</p></td></tr><tr><td colspan="2" style="height: 1px; background-color: #E5E7EB; padding: 0; margin: 8px 0;"></td></tr><tr><td width="28"><img src="https://assets.nexura.com/icons/clock.png" width="20" height="20" style="display: block;" alt="" /></td><td style="padding: 8px 0 8px 12px;"><p style="margin: 0; font-size: 12px; color: #64748B;">Hora</p><p style="margin: 0; font-size: 14px; font-weight: 600; color: #0F172A;">{{APPOINTMENT_TIME}}</p></td></tr><tr><td colspan="2" style="padding-top: 16px;"><a href="{{CALENDAR_ADD_URL}}" style="display: inline-block; background-color: #1A6FE8; color: #FFF; font-size: 13px; font-weight: 600; text-decoration: none; padding: 10px 18px; border-radius: 8px;">Agregar al calendario</a></td></tr></mj-table></mj-column></mj-section>
    <mj-section background-color="#FFFFFF" padding="0 32px 24px"><mj-column><mj-text align="center" font-size="13px" color="#64748B">¿Necesita cambiar nuevamente? <a href="{{RESCHEDULE_URL}}" style="color: #1A6FE8; text-decoration: underline;">Reprogramar cita</a> o <a href="{{CANCEL_URL}}" style="color: #1A6FE8; text-decoration: underline;">cancelar</a></mj-text></mj-column></mj-section>
    <mj-section background-color="#FFFFFF" padding="28px 32px 32px" border-top="1px solid #F1F5F9"><mj-column><mj-text align="center" font-size="12px" color="#64748B">{{ENTITY_COPYRIGHT}}</mj-text></mj-column></mj-section>
  </mj-body>
</mjml>
