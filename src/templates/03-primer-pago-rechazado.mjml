<mjml>
  <mj-head>
    <mj-font name="Plus Jakarta Sans" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" />
    <mj-attributes>
      <mj-all font-family="'Plus Jakarta Sans', Arial, Helvetica, sans-serif" color="#1F2937" />
      <mj-text font-size="14px" line-height="20px" padding="0" />
      <mj-section padding="0" />
      <mj-column padding="0" />
    </mj-attributes>
    <mj-raw>
      <!--[if mso]><style type="text/css">body, table, td, p, a, span { font-family: Arial, Helvetica, sans-serif !important; }</style><![endif]-->
    </mj-raw>
  </mj-head>
  <mj-body background-color="#F5F6FA" width="640px">
    <mj-section background-color="#FFFFFF" padding="28px 32px 20px 32px">
      <mj-group>
        <mj-column width="45%" vertical-align="middle"><mj-image src="{{ENTITY_LOGO_URL}}" alt="{{ENTITY_NAME}}" width="170px" align="left" padding="0" /></mj-column>
        <mj-column width="55%" vertical-align="middle"><mj-table padding="0 0 0 16px"><tr><td style="border-left: 1px solid #E2E8F0; padding-left: 16px;"><p style="margin: 0; font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 13px; line-height: 17px; font-weight: 600; color: #475569;">{{ENTITY_SECRETARIAT_TITLE}}</p></td></tr></mj-table></mj-column>
      </mj-group>
    </mj-section>

    <mj-section background-color="#FFFFFF" padding="12px 32px 24px 32px">
      <mj-column width="100%"><mj-text align="center" font-size="20px" line-height="28px" font-weight="700" color="#0F172A">Primer pago no procesado</mj-text></mj-column>
    </mj-section>

    <mj-section background-color="#FFFFFF" padding="24px 32px">
      <mj-column width="100%">
        <mj-table width="100%" cellpadding="0" cellspacing="0">
          <tr align="center">
            <td width="25%"><div style="width: 40px; height: 40px; background-color: #DCFCE7; border-radius: 50%; margin: 0 auto 8px; line-height: 40px; color: #15803D; font-weight: 700;">✓</div><p style="font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 12px; font-weight: 600; color: #6B7280; margin: 0;">Registro</p></td>
            <td width="25%"><div style="width: 40px; height: 40px; background-color: #FEE2E2; border-radius: 50%; margin: 0 auto 8px; line-height: 40px; color: #B91C1C; font-weight: 700; font-size: 20px;">✕</div><p style="font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 12px; font-weight: 600; color: #6B7280; margin: 0;">Primer pago</p></td>
            <td width="25%"><div style="width: 40px; height: 40px; background-color: #E5E7EB; border-radius: 50%; margin: 0 auto 8px; line-height: 40px; color: #9CA3AF; font-weight: 700;">3</div><p style="font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 12px; font-weight: 600; color: #6B7280; margin: 0;">Agendamiento</p></td>
            <td width="25%"><div style="width: 40px; height: 40px; background-color: #E5E7EB; border-radius: 50%; margin: 0 auto 8px; line-height: 40px; color: #9CA3AF; font-weight: 700;">4</div><p style="font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 12px; font-weight: 600; color: #6B7280; margin: 0;">Segundo pago</p></td>
          </tr>
        </mj-table>
      </mj-column>
    </mj-section>

    <mj-section background-color="#FFFFFF" padding="0 32px 24px 32px">
      <mj-column width="100%">
        <mj-table padding="16px" container-background-color="#FEE2E2" style="border-radius: 12px; width: 100%;">
          <tr>
            <td width="36" style="vertical-align: middle; padding-right: 12px;"><img src="https://assets.nexura.com/icons/alert-circle.png" width="28" height="28" style="display: block;" alt="" /></td>
            <td style="vertical-align: middle;"><p style="margin: 0; font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 13px; line-height: 18px; color: #B91C1C;"><strong>Pago no procesado</strong><br />Hubo un problema con tu transacción. Intenta nuevamente o contáctanos.</p></td>
          </tr>
        </mj-table>
      </mj-column>
    </mj-section>

    <mj-section background-color="#FFFFFF" padding="0 32px 24px 32px">
      <mj-column width="100%">
        <mj-table container-background-color="#F8F9FC" padding="20px 24px" style="border-radius: 16px; width: 100%;">
          <tr><td colspan="2" style="padding-bottom: 16px;"><p style="margin: 0; font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 14px; font-weight: 600; color: #334155;">Detalles del error</p></td></tr>
          <tr>
            <td width="28" style="vertical-align: middle; padding: 8px 0;"><img src="https://assets.nexura.com/icons/info.png" width="20" height="20" style="display: block;" alt="" /></td>
            <td style="vertical-align: middle; padding: 8px 12px 8px 4px;"><p style="margin: 0; font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 12px; color: #64748B;">Código de error</p><p style="margin: 0; font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 14px; font-weight: 600; color: #0F172A;">{{ERROR_CODE}}</p></td>
          </tr>
          <tr><td colspan="2" style="height: 1px; background-color: #E5E7EB; padding: 0; margin: 8px 0;"></td></tr>
          <tr>
            <td width="28" style="vertical-align: middle; padding: 8px 0;"><img src="https://assets.nexura.com/icons/message.png" width="20" height="20" style="display: block;" alt="" /></td>
            <td style="vertical-align: middle; padding: 8px 12px 8px 4px;"><p style="margin: 0; font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 12px; color: #64748B;">Mensaje</p><p style="margin: 0; font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 14px; font-weight: 600; color: #0F172A;">{{ERROR_MESSAGE}}</p></td>
          </tr>
        </mj-table>
      </mj-column>
    </mj-section>

    <mj-section background-color="#FFFFFF" padding="0 32px 24px 32px">
      <mj-column width="100%">
        <mj-button background-color="#1A6FE8" color="#FFFFFF" font-size="14px" font-weight="700" padding="14px 28px" border-radius="8px" href="{{RETRY_PAYMENT_URL}}" align="center">
          Reintentar el primer pago
        </mj-button>
      </mj-column>
    </mj-section>

    <mj-section background-color="#FFFFFF" padding="0 32px 24px 32px">
      <mj-column width="100%">
        <mj-text align="center" font-size="13px" color="#64748B" padding="16px 0 0 0">
          ¿Problemas con el pago? <a href="mailto:{{ENTITY_SUPPORT_EMAIL}}" style="color: #1A6FE8; text-decoration: underline;">Contacta a nuestro equipo de soporte</a>
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#FFFFFF" padding="28px 32px 32px 32px" border-top="1px solid #F1F5F9">
      <mj-column width="100%">
        <mj-text align="center" font-size="14px" font-weight="600" color="#334155">Gracias por utilizar nuestros servicios</mj-text>
        <mj-text align="center" font-size="12px" color="#64748B">{{ENTITY_COPYRIGHT}}</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
