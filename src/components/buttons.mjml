<!-- BOTÓN PRIMARY (Azul sólido) -->
<mj-section padding="16px 0">
  <mj-column>
    <mj-button
      background-color="#1A6FE8"
      color="#FFFFFF"
      font-size="14px"
      font-weight="700"
      font-family="'Plus Jakarta Sans', Arial, sans-serif"
      padding="14px 28px"
      border-radius="8px"
      href="{{BUTTON_PRIMARY_URL}}"
      align="center"
    >
      {{BUTTON_PRIMARY_TEXT}}
    </mj-button>
  </mj-column>
</mj-section>

