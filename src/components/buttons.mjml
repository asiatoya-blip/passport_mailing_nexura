<!-- BOTÓN PRIMARY (Azul sólido - Hug content) -->
<mj-section padding="24px 0">
  <mj-column>
    <mj-table width="100%" style="border-collapse: collapse;">
      <tr>
        <td align="center" style="padding: 0;">
          <a href="{{BUTTON_PRIMARY_URL}}" style="
            display: inline-block;
            padding: 12px 24px;
            background-color: #0F61E4;
            border-radius: 999px;
            color: #FFFFFF;
            text-decoration: none;
            font-family: 'Plus Jakarta Sans', Arial, sans-serif;
            font-size: 16px;
            font-weight: 400;
            line-height: 28.80px;
            text-align: center;
          ">
            {{BUTTON_PRIMARY_TEXT}}
          </a>
        </td>
      </tr>
    </mj-table>
  </mj-column>
</mj-section>

<!-- BOTÓN SECONDARY (Outline - Fill container) -->
<mj-section padding="16px 0">
  <mj-column>
    <mj-table width="100%" style="border-collapse: collapse;">
      <tr>
        <td align="center" style="padding: 0;">
          <a href="{{BUTTON_SECONDARY_URL}}" style="
            display: block;
            width: 100%;
            padding: 12px 24px;
            background-color: #FFFFFF;
            border: 2px solid #0F61E4;
            border-radius: 999px;
            color: #0F61E4;
            text-decoration: none;
            font-family: 'Plus Jakarta Sans', Arial, sans-serif;
            font-size: 16px;
            font-weight: 400;
            box-sizing: border-box;
            text-align: center;
            line-height: 28.80px;
          ">
            {{BUTTON_SECONDARY_TEXT}}
          </a>
        </td>
      </tr>
    </mj-table>
  </mj-column>
</mj-section>
