<mj-section background-color="#FFFFFF" padding="24px" style="border-radius: 16px; margin: 20px 20px 0 20px; border: 1px solid #E5E5EA;">
  <mj-column>
    <mj-text font-size="14px" font-weight="700" color="#1F2937" font-family="'Plus Jakarta Sans', Arial, sans-serif" margin="0 0 16px 0">
      {{QR_TITLE}}
    </mj-text>
    <mj-table width="100%" style="border-collapse: collapse;">
      <tr>
        <td width="50%" style="padding: 0 16px 0 0;">
          <mj-text font-size: 12px; color: #6B7280;">{{QR_INSTRUCTION_1}}</mj-text>
          <mj-text font-size: 12px; color: #6B7280; margin-top: 4px;>{{QR_INSTRUCTION_2}}</mj-text>
        </td>
        <td width="50%" style="padding: 0; text-align: center;">
          <img src="{{QR_IMAGE_URL}}" width="120" height="120" alt="QR Code" style="display: block; border-radius: 4px;" />
        </td>
      </tr>
    </mj-table>
  </mj-column>
</mj-section>