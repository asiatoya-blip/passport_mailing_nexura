<mj-section background-color="#F3F4F8" padding="24px" border-radius="16px" margin="16px 0">
  <mj-column>
    <mj-text align="center" font-size="14px" font-weight="700" color="#1F2937" font-family="'Plus Jakarta Sans', Arial, sans-serif" margin="0 0 16px 0">
      {{CSAT_TITLE}}
    </mj-text>

    <mj-table width="100%" style="border-collapse: collapse;">
      <tr align="center">
        <td width="20%" style="padding: 8px;">
          <a href="{{CSAT_BASE_URL}}?score=1&type={{CSAT_TYPE}}&ticket={{TICKET_ID}}" style="text-decoration: none; display: inline-block;">
            <span style="font-size: 32px;">😢</span>
            <p style="font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 11px; font-weight: 600; color: #6B7280; margin: 4px 0 0 0;">Muy difícil</p>
          </a>
        </td>
        <td width="20%" style="padding: 8px;">
          <a href="{{CSAT_BASE_URL}}?score=2&type={{CSAT_TYPE}}&ticket={{TICKET_ID}}" style="text-decoration: none; display: inline-block;">
            <span style="font-size: 32px;">😕</span>
            <p style="font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 11px; font-weight: 600; color: #6B7280; margin: 4px 0 0 0;">Difícil</p>
          </a>
        </td>
        <td width="20%" style="padding: 8px;">
          <a href="{{CSAT_BASE_URL}}?score=3&type={{CSAT_TYPE}}&ticket={{TICKET_ID}}" style="text-decoration: none; display: inline-block;">
            <span style="font-size: 32px;">😐</span>
            <p style="font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 11px; font-weight: 600; color: #6B7280; margin: 4px 0 0 0;">Normal</p>
          </a>
        </td>
        <td width="20%" style="padding: 8px;">
          <a href="{{CSAT_BASE_URL}}?score=4&type={{CSAT_TYPE}}&ticket={{TICKET_ID}}" style="text-decoration: none; display: inline-block;">
            <span style="font-size: 32px;">🙂</span>
            <p style="font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 11px; font-weight: 600; color: #6B7280; margin: 4px 0 0 0;">Fácil</p>
          </a>
        </td>
        <td width="20%" style="padding: 8px;">
          <a href="{{CSAT_BASE_URL}}?score=5&type={{CSAT_TYPE}}&ticket={{TICKET_ID}}" style="text-decoration: none; display: inline-block;">
            <span style="font-size: 32px;">😄</span>
            <p style="font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 11px; font-weight: 600; color: #6B7280; margin: 4px 0 0 0;">Muy fácil</p>
          </a>
        </td>
      </tr>
    </mj-table>

    <mj-text align="center" font-size="11px" color="#6B7280" font-family="'Plus Jakarta Sans', Arial, sans-serif" margin="12px 0 0 0">
      Tu opinión nos ayuda a mejorar 🙌
    </mj-text>
  </mj-column>
</mj-section>
