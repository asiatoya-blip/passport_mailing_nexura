<mj-section background-color="transparent" padding="20px 20px 0 20px">
  <mj-column>
    <mj-section background-color="{{NOTICE_BG}}" padding="20px" style="border-radius: 16px; margin: 0;">
      <mj-column>
        <mj-table width="100%" style="border-collapse: collapse;">
          <tr>
            <td width="40" style="padding: 0 12px 0 0; text-align: center; font-size: 20px;">{{NOTICE_ICON}}</td>
            <td style="padding: 0;">
              <mj-text font-size="14px" font-weight="700" color="{{NOTICE_TEXT_COLOR}}" font-family="'Plus Jakarta Sans', Arial, sans-serif" margin="0 0 8px 0">
                {{NOTICE_TITLE}}
              </mj-text>
              <mj-text font-size="12px" color="{{NOTICE_TEXT_COLOR}}" font-family="'Plus Jakarta Sans', Arial, sans-serif" margin="0">
                {{NOTICE_MESSAGE}}
              </mj-text>
            </td>
          </tr>
        </mj-table>
      </mj-column>
    </mj-section>
  </mj-column>
</mj-section>