<mj-section background-color="#FFFFFF" border-radius="16px" padding="24px 0" style="border-bottom: 1px solid #E5E5EA;">
  <mj-column>
    <mj-table>
      <tr>
        <td width="120" style="vertical-align: middle;">
          <img src="{{ENTITY_LOGO_URL}}" width="100" height="100" alt="{{ENTITY_NAME}}" style="border-radius: 12px;" />
        </td>
        <td width="1" style="background-color: #E5E7EB; margin: 0 16px;">
        </td>
        <td style="padding: 0 16px; vertical-align: middle;">
          <p style="font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 16px; font-weight: 700; color: #1F2937; margin: 0;">{{ENTITY_NAME}}</p>
          <p style="font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 14px; font-weight: 400; color: #6B7280; margin: 4px 0 0 0;">{{ENTITY_SECRETARIAT_TITLE}}</p>
        </td>
      </tr>
    </mj-table>
  </mj-column>
</mj-section>
