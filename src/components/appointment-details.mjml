<mj-section background-color="#FFFFFF" padding="20px" style="border-radius: 16px; margin: 20px 20px 0 20px; border: 1px solid #E5E5EA;">
  <mj-column>
    <mj-text font-size="14px" font-weight="700" color="#1F2937" font-family="'Plus Jakarta Sans', Arial, sans-serif" margin="0 0 16px 0">
      {{APPOINTMENT_DETAILS_TITLE}}
    </mj-text>
    <mj-table width="100%" style="border-collapse: collapse;">
      <tr style="border-bottom: 1px solid #E5E5EA;">
        <td width="40%" style="padding: 12px 0; font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 12px; font-weight: 600; color: #6B7280;">{{APPOINTMENT_LABEL_1}}</td>
        <td style="padding: 12px 0 12px 16px; font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 14px; color: #1F2937; font-weight: 600;">{{APPOINTMENT_VALUE_1}}</td>
      </tr>
      <tr style="border-bottom: 1px solid #E5E5EA;">
        <td style="padding: 12px 0; font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 12px; font-weight: 600; color: #6B7280;">{{APPOINTMENT_LABEL_2}}</td>
        <td style="padding: 12px 0 12px 16px; font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 14px; color: #1F2937;">{{APPOINTMENT_VALUE_2}}</td>
      </tr>
      <tr style="border-bottom: 1px solid #E5E5EA;">
        <td style="padding: 12px 0; font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 12px; font-weight: 600; color: #6B7280;">{{APPOINTMENT_LABEL_3}}</td>
        <td style="padding: 12px 0 12px 16px; font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 14px; color: #1F2937;">{{APPOINTMENT_VALUE_3}}</td>
      </tr>
      <tr>
        <td style="padding: 12px 0; font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 12px; font-weight: 600; color: #6B7280;">{{APPOINTMENT_LABEL_4}}</td>
        <td style="padding: 12px 0 12px 16px; font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 14px; color: #1F2937;">{{APPOINTMENT_VALUE_4}}</td>
      </tr>
    </mj-table>
  </mj-column>
</mj-section>