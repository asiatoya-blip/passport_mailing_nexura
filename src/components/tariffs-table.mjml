<mj-section background-color="#FFFFFF" padding="24px" style="border-radius: 16px; margin: 20px 20px 0 20px; border: 1px solid #E5E5EA;">
  <mj-column>
    <mj-text font-size="14px" font-weight="700" color="#1F2937" font-family="'Plus Jakarta Sans', Arial, sans-serif" margin="0 0 16px 0">
      {{TARIFFS_TITLE}}
    </mj-text>
    <mj-table width="100%" style="border-collapse: collapse;">
      <tr>
        <td width="33%" style="padding: 16px; text-align: center; border: 1px solid #E5E5EA; border-radius: 8px;">
          <p style="font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 12px; color: #6B7280; margin: 0 0 8px 0;">{{TARIFF1_LABEL}}</p>
          <p style="font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 20px; font-weight: 700; color: #1F2937; margin: 0;">{{TARIFF1_PRICE}}</p>
        </td>
        <td width="33%" style="padding: 16px; text-align: center; border: 1px solid #E5E5EA; border-radius: 8px;">
          <p style="font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 12px; color: #6B7280; margin: 0 0 8px 0;">{{TARIFF2_LABEL}}</p>
          <p style="font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 20px; font-weight: 700; color: #1F2937; margin: 0;">{{TARIFF2_PRICE}}</p>
        </td>
        <td width="33%" style="padding: 16px; text-align: center; border: 1px solid #E5E5EA; border-radius: 8px;">
          <p style="font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 12px; color: #6B7280; margin: 0 0 8px 0;">{{TARIFF3_LABEL}}</p>
          <p style="font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 20px; font-weight: 700; color: #1F2937; margin: 0;">{{TARIFF3_PRICE}}</p>
        </td>
      </tr>
    </mj-table>
  </mj-column>
</mj-section>