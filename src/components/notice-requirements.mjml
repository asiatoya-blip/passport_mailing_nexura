<!-- VARIANTE A: Corta -->
<mj-section background-color="#FFFFFF" padding="16px" border-radius="12px" margin="16px 0" border="1px solid #E5E7EB">
  <mj-column>
    <mj-table width="100%" style="border-collapse: collapse;">
      <tr>
        <td width="24" style="padding-right: 12px; vertical-align: top;">
          <img src="https://assets.nexura.com/icons/bell.png" width="20" height="20" alt="" />
        </td>
        <td style="vertical-align: middle;">
          <p style="font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 13px; font-weight: 600; color: #1F2937; margin: 0;">
            {{REQUIREMENTS_NOTICE_SHORT}}
          </p>
          <a href="{{REQUIREMENTS_LINK}}" style="font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 12px; font-weight: 600; color: #1A6FE8; text-decoration: none; display: inline-block; margin-top: 8px;">
            Conózcalos aquí →
          </a>
        </td>
      </tr>
    </mj-table>
  </mj-column>
</mj-section>

