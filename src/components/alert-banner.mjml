<mj-section background-color="{{ALERT_BG_COLOR}}" padding="16px" border-radius="12px" margin="16px 0">
  <mj-column>
    <mj-table width="100%" style="border-collapse: collapse;">
      <tr>
        <td width="24" style="padding-right: 12px; vertical-align: top;">
          <img src="{{ALERT_ICON_URL}}" width="20" height="20" alt="" />
        </td>
        <td style="vertical-align: middle;">
          <p style="font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 14px; font-weight: 600; color: {{ALERT_TEXT_COLOR}}; margin: 0;">
            {{ALERT_TITLE}}
          </p>
          <p style="font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 13px; font-weight: 400; color: {{ALERT_TEXT_COLOR}}; margin: 4px 0 0 0;">
            {{ALERT_MESSAGE}}
          </p>
        </td>
      </tr>
    </mj-table>
  </mj-column>
</mj-section>
