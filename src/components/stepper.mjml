<mj-section background-color="#FFFFFF" padding="32px 0">
  <mj-column>
    <mj-table width="100%" style="border-collapse: collapse;">
      <tr>
        <!-- PASO 1 -->
        <td width="25%" align="center" style="padding: 0; position: relative;">
          <table width="100%" style="border-collapse: collapse;">
            <tr>
              <td align="center" style="padding: 0 12px;">
                <table width="40" height="40" style="border-collapse: collapse; margin: 0 auto 8px; background-color: {{STEP1_BG}}; border-radius: 50%;">
                  <tr>
                    <td align="center" valign="middle" style="padding: 0; color: {{STEP1_TEXT}}; font-weight: 700; font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 18px;">
                      {{STEP1_ICON}}
                    </td>
                  </tr>
                </table>
                <p style="font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 14px; font-weight: 400; color: #000000; margin: 0;">{{STEP1_LABEL}}</p>
              </td>
            </tr>
          </table>
        </td>

        <!-- LÍNEA 1→2 -->
        <td width="25%" align="center" style="padding: 0; vertical-align: middle; position: relative;">
          <div style="height: 4px; background: linear-gradient(90deg, {{LINE1_START}} 0%, {{LINE1_END}} 100%); margin: 0 -12px; border-radius: 2px;">
            &nbsp;
          </div>
        </td>

        <!-- PASO 2 -->
        <td width="25%" align="center" style="padding: 0; position: relative;">
          <table width="100%" style="border-collapse: collapse;">
            <tr>
              <td align="center" style="padding: 0 12px;">
                <table width="40" height="40" style="border-collapse: collapse; margin: 0 auto 8px; background-color: {{STEP2_BG}}; border-radius: 50%;">
                  <tr>
                    <td align="center" valign="middle" style="padding: 0; color: {{STEP2_TEXT}}; font-weight: 700; font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 18px;">
                      {{STEP2_ICON}}
                    </td>
                  </tr>
                </table>
                <p style="font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 12px; font-weight: 600; color: #6B7280; margin: 0;">{{STEP2_LABEL}}</p>
              </td>
            </tr>
          </table>
        </td>

        <!-- LÍNEA 2→3 -->
        <td width="25%" align="center" style="padding: 0; vertical-align: middle; position: relative;">
          <div style="height: 4px; background: linear-gradient(90deg, {{LINE2_START}} 0%, {{LINE2_END}} 100%); margin: 0 -12px; border-radius: 2px;">
            &nbsp;
          </div>
        </td>

        <!-- PASO 3 -->
        <td width="25%" align="center" style="padding: 0; position: relative;">
          <table width="100%" style="border-collapse: collapse;">
            <tr>
              <td align="center" style="padding: 0 12px;">
                <table width="40" height="40" style="border-collapse: collapse; margin: 0 auto 8px; background-color: {{STEP3_BG}}; border-radius: 50%;">
                  <tr>
                    <td align="center" valign="middle" style="padding: 0; color: {{STEP3_TEXT}}; font-weight: 700; font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 18px;">
                      {{STEP3_ICON}}
                    </td>
                  </tr>
                </table>
                <p style="font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 12px; font-weight: 600; color: #6B7280; margin: 0;">{{STEP3_LABEL}}</p>
              </td>
            </tr>
          </table>
        </td>

        <!-- LÍNEA 3→4 -->
        <td width="25%" align="center" style="padding: 0; vertical-align: middle; position: relative;">
          <div style="height: 4px; background: linear-gradient(90deg, {{LINE3_START}} 0%, {{LINE3_END}} 100%); margin: 0 -12px; border-radius: 2px;">
            &nbsp;
          </div>
        </td>

        <!-- PASO 4 -->
        <td width="25%" align="center" style="padding: 0; position: relative;">
          <table width="100%" style="border-collapse: collapse;">
            <tr>
              <td align="center" style="padding: 0 12px;">
                <table width="40" height="40" style="border-collapse: collapse; margin: 0 auto 8px; background-color: {{STEP4_BG}}; border-radius: 50%;">
                  <tr>
                    <td align="center" valign="middle" style="padding: 0; color: {{STEP4_TEXT}}; font-weight: 700; font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 18px;">
                      {{STEP4_ICON}}
                    </td>
                  </tr>
                </table>
                <p style="font-family: 'Plus Jakarta Sans', Arial, sans-serif; font-size: 12px; font-weight: 600; color: #6B7280; margin: 0;">{{STEP4_LABEL}}</p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </mj-table>
  </mj-column>
</mj-section>
